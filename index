progressChecks.forEach(x=>x.addEventListener('change',updateProgress));updateProgress();
function scrollProgress(){const max=document.documentElement.scrollHeight-innerHeight;$('#progressbar').style.width=(max>0?scrollY/max*100:0)+'%';$('#backtop').classList.toggle('show',scrollY>500)}
addEventListener('scroll',scrollProgress);scrollProgress();
$('#backtop').addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));
const sections=$$('main section[id]');
const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){$$('.navlink').forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+e.target.id));}}),{rootMargin:'-20% 0px -65% 0px'});
sections.forEach(s=>observer.observe(s));
$('#search').addEventListener('input',e=>{const q=e.target.value.trim().toLowerCase();sections.forEach(s=>{const match=!q||(s.innerText+' '+(s.dataset.search||'')).toLowerCase().includes(q);s.classList.toggle('hidden',!match)});});
const questions=[
{topic:'Fisiologi',q:'Apa efek metabolik yang paling sesuai dengan kerja insulin?',opts:['Meningkatkan lipolisis dan glukoneogenesis','Meningkatkan ambilan glukosa serta sintesis glikogen','Menghambat penyimpanan protein dan energi','Meningkatkan produksi keton secara langsung','Menghambat ambilan glukosa oleh jaringan perifer'],a:1,why:'Insulin meningkatkan ambilan glukosa, sintesis glikogen dan penyimpanan energi; insulin juga menghambat glukoneogenesis serta lipolisis.',wrong:['Insulin justru menghambat lipolisis dan glukoneogenesis.','Benar: ini sesuai fungsi insulin pada PPT.','Insulin mendukung sintesis protein dan penyimpanan energi.','Pembentukan keton meningkat pada keadaan kekurangan insulin.','Insulin meningkatkan, bukan menghambat, ambilan glukosa.'],pearl:'Ingat efek insulin sebagai hormon penyimpanan energi.'},
{topic:'Patogenesis',q:'Kerusakan sel β pankreas pada DM tipe 1 terutama menyebabkan…',opts:['Peningkatan sekresi insulin yang menetap','Penurunan atau terhentinya produksi insulin','Peningkatan sekresi somatostatin sebagai satu-satunya kelainan','Penurunan glukagon sebagai mekanisme utama','Peningkatan sensitivitas jaringan terhadap insulin'],a:1,why:'PPT menjelaskan bahwa kerusakan sel β, melalui proses autoimun atau idiopatik, menurunkan atau menghentikan produksi insulin.',wrong:['Berlawanan dengan mekanisme utama pada DM tipe 1.','Benar: ini perubahan kunci yang memicu gangguan metabolisme.','Tidak dinyatakan sebagai mekanisme utama dalam materi.','Bukan mekanisme utama yang dijelaskan pada slide.','Defisiensi insulin, bukan peningkatan sensitivitas, menjadi masalah pokok.'],pearl:'Sel β adalah sumber insulin.'},
{topic:'Diagnosis',q:'Seorang anak mengalami poliuria, polidipsia, dan penurunan berat badan. Glukosa plasma sewaktu 238 mg/dL. Berdasarkan kriteria pada PPT, interpretasi yang paling tepat adalah…',opts:['Belum memenuhi kriteria glukosa karena harus ≥300 mg/dL','Memenuhi ambang glukosa untuk diabetes bila gejala klasik ada','Hanya dapat didiagnosis dengan TTGO','Menunjukkan hipoglikemia berat','Diagnosis ditentukan oleh kadar kalium saja'],a:1,why:'PPT mencantumkan gejala klasik atau krisis hiperglikemik dengan glukosa plasma ≥200 mg/dL sebagai salah satu kriteria diagnosis.',wrong:['Ambang dalam PPT adalah ≥200 mg/dL pada konteks gejala klasik/krisis.','Benar: gejala klasik disertai glukosa 238 mg/dL memenuhi kriteria tersebut.','TTGO bukan satu-satunya cara diagnosis.','238 mg/dL adalah hiperglikemia, bukan hipoglikemia.','Kalium tidak menjadi kriteria diagnosis DM dalam daftar tersebut.'],pearl:'Cocokkan angka dengan konteks pemeriksaan dan gejala.'},
{topic:'Interpretasi data',q:'Pada kasus di PPT: glukosa 242 mg/dL, keton darah 6,1 mmol/L, pH 7,255, dan HCO₃⁻ 4,7 mmol/L. Kesimpulan yang paling sesuai adalah…',opts:['Hipoglikemia tanpa gangguan asam-basa','Hiperglikemia tanpa ketosis','KAD dengan asidosis metabolik dan ketonemia','Alkalosis metabolik terkompensasi','Hasil sepenuhnya normal untuk anak'],a:2,why:'Kombinasi hiperglikemia, ketonemia tinggi, pH rendah dan bikarbonat sangat rendah mendukung ketoasidosis diabetikum.',wrong:['Glukosa justru tinggi dan terdapat asidosis/ketonemia.','Keton darah 6,1 mmol/L menunjukkan ketonemia, bukan ketiadaan ketosis.','Benar: seluruh temuan mendukung KAD.','pH dan HCO₃⁻ menunjukkan asidosis, bukan alkalosis.','Nilai tersebut tidak normal dan memerlukan penanganan segera.'],pearl:'Baca glukosa, keton, pH/HCO₃⁻ bersama-sama.'},
{topic:'Komplikasi',q:'Temuan klinis yang paling mendukung kemungkinan KAD pada pasien dengan gejala DM adalah…',opts:['Napas Kussmaul disertai muntah dan dehidrasi','Bradikardia tanpa keluhan lain','Peningkatan nafsu makan tanpa gejala lain','Ruam lokal tanpa gejala sistemik','Berat badan stabil dengan kondisi umum baik'],a:0,why:'PPT mencantumkan muntah, dehidrasi, perubahan kesadaran, dan pola napas Kussmaul sebagai manifestasi klinis KAD.',wrong:['Benar: kumpulan temuan tersebut sangat mengarah pada KAD.','Bukan pola manifestasi khas yang ditekankan dalam materi.','Polifagia merupakan gejala klasik DM, tetapi tidak spesifik untuk KAD.','Tidak cukup untuk mengarah pada KAD.','Tidak sesuai dengan gambaran klinis KAD yang dijelaskan.'],pearl:'Pada pasien DM yang sakit akut, cari tanda dehidrasi dan asidosis.'},
{topic:'Tatalaksana',q:'Manakah yang termasuk lima pilar tata laksana DM tipe 1 menurut PPT?',opts:['Antibiotik, insulin, operasi, diet, dan tirah baring','Insulin, pengaturan makan, olahraga, pemantauan mandiri, edukasi','Insulin, pembatasan cairan, antibiotik, dialisis, edukasi','Diet saja, olahraga, vitamin, antibiotik, dan observasi','Pemeriksaan HbA1c, CT scan, insulin, operasi, dan edukasi'],a:1,why:'PPT mencantumkan insulin, pengaturan makan, olahraga, pemantauan mandiri, dan edukasi.',wrong:['Tiga intervensi tersebut bukan bagian dari lima pilar pada slide.','Benar: kelima komponen sesuai materi.','Pembatasan cairan, antibiotik, dan dialisis bukan pilar rutin yang dicantumkan.','Diet dan olahraga saja tidak mencakup seluruh pilar.','HbA1c adalah pemeriksaan; CT scan dan operasi bukan pilar rutin.'],pearl:'Hafalkan lima pilar sebagai satu rangkaian.'}
];
let answers={};let revealAll=false;
function renderQuiz(){const container=$('#quizContainer');container.innerHTML='';questions.forEach((q,i)=>{const card=document.createElement('article');card.className='quizcard';card.id='question'+i;const meta=document.createElement('div');meta.className='qmeta';meta.innerHTML=`<span class="badge">Soal ${i+1} dari ${questions.length}</span><span class="badge">${q.topic}</span>`;card.append(meta);const stem=document.createElement('h3');stem.textContent=q.q;card.append(stem);const opts=document.createElement('div');opts.className='options';q.opts.forEach((op,j)=>{const b=document.createElement('button');b.className='option';b.innerHTML=`<span class="letter">${'ABCDE'[j]}.</span><span></span>`;b.lastElementChild.textContent=op;if(answers[i]===j)b.classList.add('selected');if(answers[i]!==undefined){if(j===q.a)b.classList.add('correct');else if(j===answers[i])b.classList.add('incorrect')}b.addEventListener('click',()=>{answers[i]=j;renderQuiz()});opts.append(b)});card.append(opts);const fb=document.createElement('div');fb.className='feedback';fb.hidden=answers[i]===undefined&&!revealAll; if(answers[i]!==undefined||revealAll){const ok=answers[i]===q.a;fb.innerHTML=`<strong>${answers[i]===undefined?'Pembahasan':ok?'✅ Benar':'❌ Belum tepat'}${answers[i]===undefined?'':': '+ 'ABCDE'[q.a]+'. '+q.opts[q.a]}</strong><p><strong>Penjelasan:</strong> ${q.why}</p><details class="details"><summary>Mengapa opsi lain salah?</summary><div class="detailbody"><ul class="list">${q.wrong.map((w,j)=>`<li><strong>${'ABCDE'[j]}.</strong> ${w}</li>`).join('')}</ul></div></details><p><strong>Exam pearl:</strong> ${q.pearl}</p>`}card.append(fb);container.append(card)});const correct=questions.reduce((n,q,i)=>n+(answers[i]===q.a?1:0),0);$('#score').textContent=correct+'/'+questions.length;$('#answered').textContent=Object.keys(answers).length+'/'+questions.length}
$('#resetQuiz').addEventListener('click',()=>{answers={};revealAll=false;renderQuiz();$('#quiz').scrollIntoView({behavior:'smooth'})});
$('#revealAll').addEventListener('click',()=>{revealAll=!revealAll;renderQuiz();$('#revealAll').textContent=revealAll?'Sembunyikan pembahasan yang belum dijawab':'Tampilkan semua pembahasan'});
renderQuiz();
</script>
